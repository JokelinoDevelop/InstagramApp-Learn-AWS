{
  "name": "@learn_aws_instagram/api",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmit && esbuild health=src/functions/health.ts post-image=src/functions/images/post-image.ts --bundle --sourcemap --platform=node --target=node26 --format=esm --outdir=dist --out-extension:.js=.mjs",
    "postbuild": "cd dist && zip health.zip health.mjs health.mjs.map && zip post-image.zip post-image.mjs post-image.mjs.map"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "26.x"
  }
}
